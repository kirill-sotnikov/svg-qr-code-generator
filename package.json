{
  "name": "qrcode-generator",
  "version": "1.0.0",
  "description": "Generate QR code by csv file",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "qrcode-generator": "dist/index.js"
  },
  "author": "xTag Team",
  "license": "MIT",
  "packageManager": "yarn@1.22.17",
  "scripts": {
    "gen": "tsx src/index.ts",
    "insert":"tsx src/insert.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit.test.ts",
    "test:integration": "vitest run tests/integration.test.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "@zxing/library": "^0.23.0",
    "csv-parse": "^7.0.1",
    "jsdom": "^29.1.1",
    "qr-code-styling": "^1.9.2",
    "sharp": "^0.35.3"
  }
}
